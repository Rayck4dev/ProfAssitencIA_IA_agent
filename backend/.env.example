# Copie este arquivo para ".env" (na mesma pasta) e preencha a chave.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# --- Obrigatório ---------------------------------------------------------
# Chave da API do Groq (gratuita): https://console.groq.com/keys
GROQ_API_KEY=

# --- IA (valores padrão mostrados) ---------------------------------------
# Modelo de texto. O padrão é um modelo de RACIOCÍNIO: os tokens que ele "pensa" contam
# dentro do limite de resposta. Para trocar, veja os modelos disponíveis no console da Groq.
# GROQ_MODEL=openai/gpt-oss-20b
# Modelo de voz (Whisper)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Teto da resposta, em tokens (inclui o raciocínio). O sistema pede o máximo que couber
# no limite por minuto, até este teto.
# GROQ_MAX_TOKENS=4096
# Esforço de raciocínio: low (padrão), medium ou high. Mais esforço = respostas mais lentas e mais tokens.
# GROQ_REASONING_EFFORT=low
# Limite de tokens POR MINUTO do seu plano (entrada + saída). Plano gratuito do gpt-oss-20b: 8000.
# Veja console.groq.com/settings/limits. 0 desliga o cálculo.
# GROQ_TPM_LIMIT=8000
# GROQ_MIN_OUTPUT_TOKENS=2500
# TEMPERATURE=0.5
# Tentativas em erros temporários e espera máxima (s) por limite de taxa
# GROQ_MAX_ATTEMPTS=3
# GROQ_MAX_RETRY_WAIT_SECONDS=20

# --- Liberdade para perguntar --------------------------------------------
# false (padrão): modo livre, responde sempre e usa os documentos como referência.
# true: modo rígido, só responde com base nos documentos.
# RAG_STRICT=false
# Título da conversa: false (padrão) = automático e local; true = pede à IA (gasta cota).
# TITLE_WITH_AI=false

# --- Documentos (RAG) ----------------------------------------------------
# RAG_ENABLED=true
# Quantos trechos dos documentos entram em cada pergunta e quantos caracteres, no máximo.
# O limite por minuto soma entrada e saída; trechos maiores deixam menos espaço para a resposta.
# Com plano pago, pode subir (ex.: RAG_MAX_CHARS=12000).
# RAG_TOP_K=6
# RAG_MAX_CHARS=5000
# Caracteres do histórico reenviados a cada pergunta
# HISTORY_MAX_CHARS=7000
# Base de conhecimento gerada por "python -m app.rag.ingest" (padrão: data/knowledge.sqlite)
# KNOWLEDGE_DB_PATH=data/knowledge.sqlite

# --- Voz -----------------------------------------------------------------
# TRANSCRIPTION_LANGUAGE=pt
# MAX_AUDIO_MB=20

# --- Servidor ------------------------------------------------------------
# HOST=127.0.0.1
# PORT=5000
# OPEN_BROWSER=true
# ENABLE_DOCS=true
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# DATABASE_PATH=profassistenc.db
