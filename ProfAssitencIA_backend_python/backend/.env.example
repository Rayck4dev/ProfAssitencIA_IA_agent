# Copie este arquivo para ".env" (na mesma pasta) e preencha a chave.
# O arquivo .env NÃO deve ser enviado ao GitHub (já está no .gitignore).

# --- Obrigatório ---------------------------------------------------------
# Chave da API do Groq (gratuita): https://console.groq.com/keys
GROQ_API_KEY=

# --- IA (valores padrão mostrados) ---------------------------------------
# Modelo de texto. O padrão é o Llama mais leve. Para respostas melhores em
# português, experimente: llama-3.3-70b-versatile (limites diferentes no plano grátis)
# GROQ_MODEL=llama-3.1-8b-instant
# Modelo de voz (Whisper)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Tamanho máximo da resposta, em tokens
# GROQ_MAX_TOKENS=1500
# TEMPERATURE=0.4
# Tentativas em erros temporários e espera máxima (s) por limite de taxa
# GROQ_MAX_ATTEMPTS=3
# GROQ_MAX_RETRY_WAIT_SECONDS=20

# --- Documentos (RAG) ----------------------------------------------------
# RAG_ENABLED=true
# Quantos trechos dos documentos entram em cada pergunta e quantos caracteres, no máximo.
# No plano gratuito do modelo 8B o limite é de 6.000 tokens por minuto (entrada + saída),
# então não aumente muito. Com plano pago, pode subir (ex.: RAG_MAX_CHARS=12000).
# RAG_TOP_K=6
# RAG_MAX_CHARS=4500
# Caracteres do histórico reenviados a cada pergunta
# HISTORY_MAX_CHARS=4500
# Base de conhecimento gerada por "python -m app.rag.ingest" (padrão: data/knowledge.sqlite)
# KNOWLEDGE_DB_PATH=data/knowledge.sqlite

# --- Voz -----------------------------------------------------------------
# TRANSCRIPTION_LANGUAGE=pt
# MAX_AUDIO_MB=20

# --- Servidor ------------------------------------------------------------
# HOST=127.0.0.1
# PORT=5000
# OPEN_BROWSER=true
# ENABLE_DOCS=true
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# DATABASE_PATH=profassistenc.db
